@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<script src="~/js/fieldValidator.js"></script>

<div class="text-left">
    <h1>Sendsign Demo</h1>
    <form action="" method="post" class="form-floating needs-validation" novalidate style="max-width: 600px">
        <table>
            <tr>
                <td><label for="CustomerKey" class="required">Customer key</label></td>
                <td><input asp-for="CustomerKey" class="form-control" type="text" id="customer_key" value="@Model.CustomerKey" required></td>
            </tr>
            <tr>
                <td><label for="Sender" class="required">Sender</label></td>
                <td><input asp-for="Sender" class="form-control" type="text" id="sender" value="@Model.Sender" required></td>
            </tr>
        </table>
        <button class="btn btn-primary btn-block" type="submit">Submit</button>
    </form>

    <p>
        Please contact sales at <a href="mailto:ciceron@@twoday.com">ciceron@@twoday.com</a> customer key and sender id
    </p>
</div>
